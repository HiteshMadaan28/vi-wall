# ============================================================================
# The VI Wall — environment configuration
# Copy to .env.local for development, or set these in your host (e.g. Vercel).
# NEVER commit real secrets. Public (NEXT_PUBLIC_*) values are exposed to the
# browser by design; everything else is server-only.
# ============================================================================

# ---- Supabase (required for a working database) ----------------------------
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# ---- Claim flow -------------------------------------------------------------
# true  (default): verified claims are auto-approved and count immediately.
# false: verified claims wait in the admin queue for manual approval.
AUTO_APPROVE_CLAIMS=true

# ---- Email verification (optional — uses Resend) ----------------------------
# If unset, the claim UI works but marks claims as "pending" and, in dev only,
# surfaces the verification link on-screen instead of pretending to send email.
RESEND_API_KEY=
EMAIL_FROM=The VI Wall <noreply@your-domain.com>

# ---- Admin console (required to use /admin) ---------------------------------
# Choose a strong password and a long random secret (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Analytics (optional) ---------------------------------------------------
# When unset, no analytics script loads and all tracking is a no-op.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Countdown (optional) ---------------------------------------------------
# ISO 8601 date. When unset, the countdown is hidden (no fabricated date).
NEXT_PUBLIC_EVENT_DATE=
NEXT_PUBLIC_EVENT_TIMEZONE=UTC

# ---- Wall resolution (optional) ---------------------------------------------
# Columns the VI silhouette is rasterised into. Changing this changes capacity.
# If you change it, re-run `npm run gen:tiles` and re-apply the tile migration.
NEXT_PUBLIC_WALL_COLS=132
